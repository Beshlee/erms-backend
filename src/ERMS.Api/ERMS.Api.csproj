<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- FR-48: controller/action üzerindeki /// <summary> yorumlarının Swagger UI'da görünmesi için. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Her public üye için XML doc zorunluluğu (CS1591) istemiyoruz — sadece varsa gösterilsin. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <UserSecretsId>86e15b05-a60c-416a-9605-61812c0bf705</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ERMS.Application\ERMS.Application.csproj" />
    <ProjectReference Include="..\ERMS.Infrastructure\ERMS.Infrastructure.csproj" />
    <ProjectReference Include="..\ERMS.Domain\ERMS.Domain.csproj" />
  </ItemGroup>

</Project>
